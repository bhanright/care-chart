{
  "name": "care-chart",
  "version": "1.0.0",
  "description": "A shared home care chart for family caregivers: medications, doses, visits and daily care. Not medical software.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8790 --test-scheduled",
    "migrate:local": "wrangler d1 migrations apply care-chart --local",
    "migrate:remote": "wrangler d1 migrations apply care-chart --remote",
    "deploy": "wrangler d1 migrations apply care-chart --remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-schedule.mjs && node scripts/check-medication-search.mjs",
    "seed:local": "node scripts/seed-local.mjs",
    "icons": "python scripts/make_icons.py",
    "vapid": "node scripts/make-vapid.mjs",
    "build:medications": "node scripts/build-medication-list.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
